; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Addons]

ButtonPrompts/prompts/light_themed_keyboard_and_mouse=false
ButtonPrompts/prompts/positional_controller_button_prompts=false
ButtonPrompts/optional_supported_controllers/dualshock_4=true
ButtonPrompts/optional_supported_controllers/dualshock_3=true
ButtonPrompts/optional_supported_controllers/xbox_one=true
ButtonPrompts/optional_supported_controllers/xbox_360=true
ButtonPrompts/optional_supported_controllers/steam_deck=true
ButtonPrompts/optional_supported_controllers/nintendo_switch=true

[application]

config/name="ZIMA"
run/main_scene="uid://fnwjbm7urb4m"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

button_prompts_manager="*uid://cy31x45v8vmkc"
Audio="*uid://cujwm7u5pvogl"
MouseLook="*uid://i0xtt6yhk6tn"
InputHelper="*uid://cholww48njaeh"
MessageBanner="*res://feed/hud_banner.gd"
NearPrompt="*res://feed/near_prompt.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/button_prompts_for_godot/plugin.cfg", "res://addons/input_helper/plugin.cfg", "res://addons/quick_audio/plugin.cfg", "res://addons/godot_retro/plugin.cfg", "res://addons/footstepper/plugin.cfg")

